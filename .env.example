# Lấy giá trị local bằng: pnpm exec supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng trên server (form khách sau captcha, tạo tài khoản nhân viên). Không đưa ra client.
SUPABASE_SECRET_KEY=
# Captcha Cloudflare Turnstile cho form đặt váy của khách. Để trống khi chạy với Supabase local
# (form bỏ qua captcha); môi trường thật bắt buộc có, thiếu thì form khách không đặt được.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
